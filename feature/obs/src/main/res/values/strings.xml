    <string name="obs_panel_title">OBS · %1$s</string>
    <string name="obs_panel_info">A remote control for OBS running on your other computer — straight from your phone 🎬\n\nWhat it can do:\n• tap a scene — it goes live in the program\n• start/stop the OBS stream\n• turn recording on/off\n\nNot connecting? Check: OBS is running, WebSocket is enabled, and the firewall isn\'t blocking it.</string>

    <string name="obs_auth_failed_error">OBS didn\'t accept the password. Check it in settings ⚙ and reopen the panel.</string>
