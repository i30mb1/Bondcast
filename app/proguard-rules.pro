# ==============================================================================
# R8/ProGuard правила оптимизации
# ==============================================================================

# ------------------------------------------------------------------------------
# Оптимизация кода
# ------------------------------------------------------------------------------

# Количество проходов оптимизации. Больше проходов = лучшая оптимизация,
# но дольше сборка. Значение 5 — хороший баланс между качеством и скоростью.
-optimizationpasses 5

# Разрешает R8 изменять модификаторы доступа (private -> public и т.д.)
# для лучшей оптимизации и инлайнинга методов.
-allowaccessmodification

# Перемещает все классы в корневой пакет (пустая строка = корень).
# Уменьшает размер APK за счёт сокращения длины имён пакетов.
-repackageclasses ''

# ------------------------------------------------------------------------------
# Удаление отладочного кода
# ------------------------------------------------------------------------------

# Удаляет вызовы логирования (verbose, debug, info) из release-сборки.
# Уменьшает размер APK и повышает производительность.
# Уровни warn и error сохранены для диагностики проблем в продакшене.
-assumenosideeffects class android.util.Log {
    public static int v(...);
    public static int d(...);
    public static int i(...);
}

# ------------------------------------------------------------------------------
# Kotlin-специфичные оптимизации
# ------------------------------------------------------------------------------

# Удаляет проверки Kotlin на null (checkNotNull, checkNotNullParameter и т.д.).
# Требует AGP 9.0.0+. Уменьшает размер APK и повышает производительность.
# Безопасно, если код корректно обрабатывает nullable типы.
-processkotlinnullchecks remove
